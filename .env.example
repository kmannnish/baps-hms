# Copy this file to ".env" (the installer does this for you) and fill it in.
# .env is NOT committed to GitHub, so this PC's secret key stays private and
# code updates (git pull) never overwrite it.

# Required: a long random secret for signing logins. The installer generates one.
# To make your own: any 48+ random characters.
JWT_SECRET=change_me_to_a_long_random_string

# Optional: daily email reports (free Gmail works — see SETUP-RECEPTION-PC.md Part 8).
# Leave blank to keep email off.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your16charAppPassword
# SMTP_FROM=BAPS Jaipur Utara <youraddress@gmail.com>
