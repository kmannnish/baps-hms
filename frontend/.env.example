# frontend/.env.example — copy to frontend/.env
# Create React App only picks up REACT_APP_* variables (and HOST/PORT),
# and only from a .env file in this folder (not the project root).

# HOST=0.0.0.0 makes the dev server reachable from other devices on the
# same WiFi network, not just this PC — required for the "any device on
# the local network" access pattern described in SETUP.md.
HOST=0.0.0.0

# For local-only testing on this one PC, localhost is fine. Once you want
# other devices (Swami Ji's phone, a laptop) to reach the app, replace
# these with this PC's actual LAN IP — e.g. http://192.168.1.42:4000.
# See SETUP.md for finding that IP and making it stay fixed.
REACT_APP_API_BASE_URL=http://localhost:4000
REACT_APP_SOCKET_URL=http://localhost:4000

# NOTE: this file (and frontend/.env) is the RECEPTION / LAN build, served by
# `npm start`. The PUBLIC guest+Swami site that goes on Netlify is a separate
# `npm run build`, which reads frontend/.env.production instead — that file
# points at the Render cloud backend. See SETUP.md §7 ("Going online").
