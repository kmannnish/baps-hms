# frontend/.env.production — the PUBLIC guest + Swami site (Netlify build).
#
# Create React App automatically reads THIS file (not frontend/.env) when you
# run `npm run build`. So the public bundle you upload to Netlify points at the
# always-on Render cloud backend, while the Reception PC keeps using
# frontend/.env (its LAN IP) with `npm start`. See SETUP.md §7.
#
# Replace the placeholder below with YOUR Render service URL once it's live
# (Render shows it as https://<your-service>.onrender.com). Both must be the
# same Render origin — Socket.io shares it. No trailing slash.
REACT_APP_API_BASE_URL=https://baps-hms-cloud.onrender.com
REACT_APP_SOCKET_URL=https://baps-hms-cloud.onrender.com
